            <ambient>0.16 0.38 0.12 1</ambient>
            <diffuse>0.16 0.38 0.12 1</diffuse>
            <pbr><metal><albedo_map>model://obst_avoidance/models/textures/leaves.png</albedo_map><roughness>0.9</roughness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= ZONE D: x=108-122, MIXED (textured + two textureless) ================= -->
    <!-- narrowD1 (Step P): a SECOND, narrow textureless positive case,
         distinct from wallD1/wallB1. wallB1 is 16m wide and bleeds into
         every sector well before close range; this one is only 3.5m
         wide, on the y=0 centerline, so it should stay confined to the
         center sector(s) even at moderate range - the geometric
         signature centre-vs-outer sector comparisons are meant to
         detect. 8m clear of treeD1, 11m clear of boxD1, 13.6m clear of
         wallD1 - a straight y=0 pass hits narrowD1 and wallD1 as two
         separate, well-separated events. -->
    <model name="narrowD1">
      <static>true</static>
      <pose>108 0 3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 3.5 6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 3.5 6</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="treeD1">
      <static>true</static>
      <pose>116 -3.5 0 0 0 0</pose>
      <link name="trunk">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>5</length></cylinder></geometry>
          <pose>0 0 2.5 0 0 0</pose>
        </collision>
        <visual name="trunk_visual">
          <geometry><cylinder><radius>0.25</radius><length>5</length></cylinder></geometry>
          <pose>0 0 2.5 0 0 0</pose>
          <material>
            <ambient>0.35 0.22 0.12 1</ambient>
            <diffuse>0.35 0.22 0.12 1</diffuse>
            <pbr><metal><albedo_map>model://obst_avoidance/models/textures/bark.png</albedo_map><roughness>0.85</roughness></metal></pbr>
          </material>
        </visual>
        <visual name="leaves">
          <geometry><sphere><radius>1.7</radius></sphere></geometry>
          <pose>0 0 5.5 0 0 0</pose>
          <material>
            <ambient>0.16 0.38 0.12 1</ambient>
            <diffuse>0.16 0.38 0.12 1</diffuse>
            <pbr><metal><albedo_map>model://obst_avoidance/models/textures/leaves.png</albedo_map><roughness>0.9</roughness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="boxD1">
      <static>true</static>
      <pose>119 2 0 0 0 -0.25</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 1.8 3.5</size></box></geometry>
          <pose>0 0 1.75 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.8 1.8 3.5</size></box></geometry>
          <pose>0 0 1.75 0 0 0</pose>
          <material>
            <ambient>0.48 0.42 0.36 1</ambient>
            <diffuse>0.48 0.42 0.36 1</diffuse>
            <pbr><metal><albedo_map>model://obst_avoidance/models/textures/stone.png</albedo_map><roughness>0.8</roughness></metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- The one deliberately textureless surface in this mixed zone,
         on the y=0 centerline - discrimination test target. -->
    <model name="wallD1">
      <static>true</static>
      <pose>122 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 10 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 10 5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
