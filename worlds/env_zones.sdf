          </material>
        </visual>
        <visual name="leaves">
          <geometry><sphere><radius>1.8</radius></sphere></geometry>
          <pose>0 0 5.5 0 0 0</pose>
          <material>
            <ambient>0.16 0.38 0.12 1</ambient>
            <diffuse>0.16 0.38 0.12 1</diffuse>
