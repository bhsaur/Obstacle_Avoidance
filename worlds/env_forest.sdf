    </model>
    <model name="tree4">
      <static>true</static>
      <pose>10 4 0 0 0 0</pose>

      <link name="trunk">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <pose>0 0 1 0 0 0</pose>
        </collision>

        <visual name="trunk_visual">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>2</length>
            </cylinder>
          </geometry>
          <pose>0 0 1 0 0 0</pose>
          <material>
            <ambient>0.45 0.25 0.1 1</ambient>
