        </visual>

        <visual name="leaves">
          <geometry>
            <sphere>
              <radius>0.8</radius>
            </sphere>
          </geometry>
          <pose>0 0 2.3 0 0 0</pose>
          <material>
            <ambient>0 0.6 0 1</ambient>
            <diffuse>0 0.6 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="tree2">
      <static>true</static>
