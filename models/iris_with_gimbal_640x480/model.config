<?xml version="1.0" ?>
<model>
  <name>Iris with Gimbal (640x480)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    Local override of ardupilot_gazebo's iris_with_gimbal that points its
    gimbal include at obst_avoidance's gimbal_small_3d_640x480 override
    (corrected camera resolution) instead of the upstream gimbal_small_3d.
    Everything else is identical to the upstream model.
  </description>
</model>
