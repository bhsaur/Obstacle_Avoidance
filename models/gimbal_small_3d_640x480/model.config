<?xml version="1.0" ?>
<model>
  <name>Gimbal Small 3D (640x480)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    Local override of ardupilot_gazebo's gimbal_small_3d with the camera
