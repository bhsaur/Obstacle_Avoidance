<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>obst_avoidance</name>
  <version>0.0.0</version>
  <description>Obstacle avoidance for the ArduPilot/Gazebo drone stack</description>
  <maintainer email="prateek09bhardwaj05@gmail.com">saurabh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>cv_bridge</depend>

  <exec_depend>mavros</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ardupilot_gz_bringup</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
